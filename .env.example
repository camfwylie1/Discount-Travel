# ─────────────────────────────────────────────────────────────────────────────
#  VOYAJ — ENVIRONMENT CONFIGURATION
#  Copy this file to `.env` and fill in the values. Never commit `.env`.
#  Every variable is explained in plain English in README.md → "Environment variables".
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: DATABASE ───────────────────────────────────────────────────────
# Where your PostgreSQL database lives. Locally this is created for you by
# `npm run setup`. In production, paste the connection string your database
# host (Neon / Supabase / RDS) gives you.
DATABASE_URL="postgresql://voyaj:voyaj_dev_password@127.0.0.1:5432/voyaj_dev?schema=public"

# Used only when running the automated test suite. Must be a DIFFERENT database
# to your development one — the tests wipe it clean on every run.
TEST_DATABASE_URL="postgresql://voyaj:voyaj_dev_password@127.0.0.1:5432/voyaj_test?schema=public"

# ── REQUIRED: SECURITY ───────────────────────────────────────────────────────
# A long random secret used to sign cookies and hash session tokens.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# The public address of your site. Used for links in emails, Stripe redirects
# and OpenGraph tags. Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── OPTIONAL: STRIPE (payments) ──────────────────────────────────────────────
# Without these the app still runs; the checkout page shows a clear
# "payments not configured" state instead of a broken flow.
# Get them at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Created when you run `npm run stripe:listen` (local) or in the Stripe
# dashboard under Developers → Webhooks (production).
STRIPE_WEBHOOK_SECRET=""
# The Price ID (starts with `price_`) of your $99 CAD/year membership.
# Create it in Stripe → Product catalogue. If left blank, the app creates a
# matching test-mode product/price automatically on first checkout.
STRIPE_PRICE_ID_ANNUAL=""

# ── OPTIONAL: AI ─────────────────────────────────────────────────────────────
# Which provider to use: "anthropic", "openai" or "fallback".
# "fallback" needs no key and produces deterministic, template-written copy so
# the product is fully demonstrable with no AI account at all.
AI_PROVIDER="fallback"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL=""              # optional override, e.g. claude-sonnet-5

# A hard monthly ceiling on AI spend. Once this calendar month's recorded cost
# reaches it, every capability falls back to the deterministic provider instead
# of calling a paid API — the product keeps working, the writing just gets
# plainer.
#
# The ceiling needs prices to measure against. Token counts are always
# recorded; dollars are only worked out when the two rates below are set, taken
# from your provider's current pricing page. Leave them blank and spend is
# recorded in tokens only, with the dollar ceiling inactive.
AI_MONTHLY_BUDGET_USD="25"
AI_INPUT_USD_PER_MTOK=""    # dollars per million input tokens
AI_OUTPUT_USD_PER_MTOK=""   # dollars per million output tokens

# ── OPTIONAL: FILE STORAGE (profile photos) ──────────────────────────────────
# "local" writes to ./public/uploads (fine for development).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── OPTIONAL: EMAIL ──────────────────────────────────────────────────────────
# "console" prints verification/reset links to your terminal — perfect for
# development and demos. "resend" sends real email.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Voyaj <hello@example.com>"

# ── OPTIONAL: ANALYTICS & MONITORING ─────────────────────────────────────────
# All events are always written to our own database first; these are extra sinks.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
SENTRY_DSN=""

# ── FEATURE FLAGS ────────────────────────────────────────────────────────────
# Turn whole areas of the product on or off without touching code.
FEATURE_SOCIAL_ENABLED="true"
FEATURE_AI_ENABLED="true"
FEATURE_PAYWALL_ENABLED="true"
FEATURE_MAP_ENABLED="false"
FEATURE_AFFILIATE_TRACKING_ENABLED="true"
FEATURE_REFERRALS_ENABLED="false"
FEATURE_GROUP_TRIPS_ENABLED="true"

# ── COMMERCIAL CONFIGURATION ─────────────────────────────────────────────────
# Price is read from here and from Stripe — it is never hardcoded in the UI.
MEMBERSHIP_PRICE_CENTS="9900"
MEMBERSHIP_CURRENCY="CAD"
MEMBERSHIP_INTERVAL="year"
DEFAULT_MARKET_COUNTRY="CA"
DEFAULT_CURRENCY="CAD"

# ── DEMO ─────────────────────────────────────────────────────────────────────
# Credentials for the pre-populated investor demo account created by `npm run seed`.
DEMO_ACCOUNT_EMAIL="demo@voyaj.test"
DEMO_ACCOUNT_PASSWORD="VoyajDemo!2025"
ADMIN_ACCOUNT_EMAIL="admin@voyaj.test"
ADMIN_ACCOUNT_PASSWORD="VoyajAdmin!2025"
# Set to "false" in production so demo/seed content can never be mistaken for
# live travel inventory.
SEED_DEMO_DATA="true"
